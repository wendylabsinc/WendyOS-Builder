From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Wendy Labs <engineering@wendy.dev>
Date: Thu, 29 Oct 2026 12:00:00 +1100
Subject: [PATCH] arm64: dts: qcom: monaco-evk: power the USB1 host connector

The M.2 Bluetooth routing selects and releases the internal hub, but its
external USB1 Type-C port also needs the HD3SS3220 controller and switched
5 V supply. Describe the connector, controller, ID/interrupt pins and hub
graph so the existing Type-C driver powers attached USB peripherals.
Keep this wiring scoped to the Monaco EVK, matching the M.2 routing patch.

Adapt the remaining USB1 host-port wiring from Qualcomm's proposal. USB2
remains the Wendy gadget and USB0 remains the recovery connector.

Link: https://lore.kernel.org/all/20260430142000.3707614-1-swati.agarwal@oss.qualcomm.com/
Upstream-Status: Pending [board-scoped adaptation of the linked Qualcomm proposal]
Signed-off-by: Wendy Labs <engineering@wendy.dev>
---
--- a/arch/arm64/boot/dts/qcom/monaco-evk.dts
+++ b/arch/arm64/boot/dts/qcom/monaco-evk.dts
@@ -135,3 +135,137 @@
 &usb_1 {
 	dr_mode = "host";
 };
+
+/* External USB1 host connector, separate from the M.2 Bluetooth hub port. */
+/ {
+	connector-1 {
+		compatible = "usb-c-connector";
+		label = "USB1-Type-C";
+		data-role = "host";
+		power-role = "source";
+		vbus-supply = <&usb1_vbus>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				usb1_con_hs_ep: endpoint {
+					remote-endpoint = <&usb_hub_2_1>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				usb1_con_ss_ep: endpoint {
+					remote-endpoint = <&hd3ss3220_1_in_ep>;
+				};
+			};
+		};
+	};
+
+	usb1_vbus: regulator-usb1-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb1_vbus";
+		gpio = <&expander1 3 GPIO_ACTIVE_HIGH>;
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+		enable-active-high;
+	};
+};
+
+&i2c0 {
+	usb-typec@47 {
+		compatible = "ti,hd3ss3220";
+		reg = <0x47>;
+		interrupts-extended = <&tlmm 45 IRQ_TYPE_EDGE_FALLING>;
+		id-gpios = <&tlmm 13 GPIO_ACTIVE_HIGH>;
+		pinctrl-0 = <&usb1_id>, <&usb1_intr>;
+		pinctrl-names = "default";
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				hd3ss3220_1_in_ep: endpoint {
+					remote-endpoint = <&usb1_con_ss_ep>;
+				};
+			};
+
+			port@1 {
+				reg = <1>;
+				hd3ss3220_1_out_ep: endpoint {
+					remote-endpoint = <&usb_hub_3_1>;
+				};
+			};
+		};
+	};
+};
+
+&tlmm {
+	usb1_id: usb1-id-state {
+		pins = "gpio13";
+		function = "gpio";
+		bias-pull-up;
+	};
+
+	usb1_intr: usb1-intr-state {
+		pins = "gpio45";
+		function = "gpio";
+		bias-pull-up;
+		drive-strength = <2>;
+	};
+};
+
+&usb_1 {
+	#address-cells = <1>;
+	#size-cells = <0>;
+
+	usb_hub_2_x: hub@1 {
+		compatible = "usb5e3,610";
+		reg = <1>;
+		peer-hub = <&usb_hub_3_x>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@1 {
+				reg = <1>;
+				usb_hub_2_1: endpoint {
+					remote-endpoint = <&usb1_con_hs_ep>;
+				};
+			};
+
+			/* M.2 E-key Bluetooth uses the hub's separate port 4. */
+			port@4 {
+				reg = <4>;
+			};
+		};
+	};
+
+	usb_hub_3_x: hub@2 {
+		compatible = "usb5e3,625";
+		reg = <2>;
+		peer-hub = <&usb_hub_2_x>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@1 {
+				reg = <1>;
+				usb_hub_3_1: endpoint {
+					remote-endpoint = <&hd3ss3220_1_out_ep>;
+				};
+			};
+
+			port@4 {
+				reg = <4>;
+			};
+		};
+	};
+};
-- 
