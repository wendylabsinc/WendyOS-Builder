diff --git a/src/nan/nan_ndl.c b/src/nan/nan_ndl.c
index ce0e212..084af15 100644
--- a/src/nan/nan_ndl.c
+++ b/src/nan/nan_ndl.c
@@ -785,12 +785,9 @@ static int nan_ndl_parse_ndc_attr(struct nan_data *nan,
 				  const u8 **ndc_schedule,
 				  u16 *ndc_schedule_len)
 {
+	const u8 *pos;
 	u16 ext_ndc_len;
 
-	/* Consider only the selected NDC */
-	if (!(ndc_attr->ctrl & NAN_NDC_CTRL_SELECTED))
-		return -1;
-
 	if (ndc_attr_len < sizeof(*ndc_attr))
 		return -1;
 	ext_ndc_len = ndc_attr_len - sizeof(*ndc_attr);
@@ -801,8 +798,30 @@ static int nan_ndl_parse_ndc_attr(struct nan_data *nan,
 		return -1;
 	}
 
+	/* Check every schedule entry before treating an unselected NDC as a
+	 * valid, informational proposal in an NDL Request. */
+	pos = (const u8 *) (ndc_attr + 1);
+	while (ext_ndc_len) {
+		const struct nan_sched_entry *entry;
+		u16 entry_len;
+
+		if (ext_ndc_len < sizeof(*entry))
+			return -1;
+		entry = (const struct nan_sched_entry *) pos;
+		entry_len = sizeof(*entry) + entry->len;
+		if (entry_len > ext_ndc_len)
+			return -1;
+		pos += entry_len;
+		ext_ndc_len -= entry_len;
+	}
+
+	/* A Request can propose an NDC without selecting it. Keep it out of
+	 * the selected NDC fields so the responder chooses its own schedule. */
+	if (!(ndc_attr->ctrl & NAN_NDC_CTRL_SELECTED))
+		return 1;
+
 	os_memcpy(ndc_id, ndc_attr->ndc_id, sizeof(ndc_attr->ndc_id));
-	*ndc_schedule_len = ext_ndc_len;
+	*ndc_schedule_len = ndc_attr_len - sizeof(*ndc_attr);
 	*ndc_schedule = (const u8 *) (ndc_attr + 1);
 
 	wpa_printf(MSG_DEBUG, "NAN: NDL: ndc_id=" MACSTR " schedule_len=%u",
@@ -811,6 +830,104 @@ static int nan_ndl_parse_ndc_attr(struct nan_data *nan,
 }
 
 
+static int nan_ndl_parse_ndc_attrs(struct nan_data *nan,
+				   struct dl_list *ndc_attrs,
+				   enum nan_ndl_type type, u8 *ndc_id,
+				   const u8 **ndc_schedule,
+				   u16 *ndc_schedule_len)
+{
+	struct nan_attrs_entry *n;
+
+	if (dl_list_empty(ndc_attrs))
+		return -1;
+
+	dl_list_for_each(n, ndc_attrs, struct nan_attrs_entry, list) {
+		int ret = nan_ndl_parse_ndc_attr(nan,
+			(const struct ieee80211_ndc *) n->ptr, n->len,
+			ndc_id, ndc_schedule, ndc_schedule_len);
+
+		if (ret < 0)
+			return -1;
+		if (ret == 0)
+			return 0;
+	}
+
+	/* An NDL Request may carry only unselected candidate NDCs. The
+	 * responder will generate and select the NDC in its Response. */
+	return type == NAN_NDL_TYPE_REQUEST ? 0 : -1;
+}
+
+
+#ifdef CONFIG_MODULE_TESTS
+int nan_ndl_test_ndc_attrs(void)
+{
+	/* Pixel 7 NDP Request NDC: unselected, one four-byte time bitmap. */
+	u8 candidate[] = {
+		0x00, 0x02, 0x22, 0x1f, 0x9f, 0x8d, 0x00,
+		0x00, 0x18, 0x00, 0x04, 0x02, 0x00, 0x00, 0x00,
+	};
+	u8 selected[sizeof(candidate)];
+	u8 ndc_id[ETH_ALEN] = { 0 };
+	const u8 *sched = NULL;
+	u16 sched_len = 0;
+	struct dl_list attrs;
+	struct nan_attrs_entry first, second;
+	int ret;
+
+	os_memcpy(selected, candidate, sizeof(selected));
+	selected[ETH_ALEN] = NAN_NDC_CTRL_SELECTED;
+	first.ptr = candidate;
+	first.len = sizeof(candidate);
+	second.ptr = selected;
+	second.len = sizeof(selected);
+	dl_list_init(&attrs);
+	dl_list_add_tail(&attrs, &first.list);
+
+	ret = nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_REQUEST,
+				      ndc_id, &sched, &sched_len);
+	if (ret || !is_zero_ether_addr(ndc_id) || sched || sched_len)
+		goto fail;
+	if (!nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_RESPONSE,
+				     ndc_id, &sched, &sched_len) ||
+	    !nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_CONFIRM,
+				     ndc_id, &sched, &sched_len))
+		goto fail;
+
+	/* A selected NDC takes precedence over an earlier candidate. */
+	dl_list_add_tail(&attrs, &second.list);
+	ret = nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_REQUEST,
+				      ndc_id, &sched, &sched_len);
+	if (ret || os_memcmp(ndc_id, selected, ETH_ALEN) ||
+	    sched != selected + sizeof(struct ieee80211_ndc) ||
+	    sched_len != sizeof(selected) - sizeof(struct ieee80211_ndc))
+		goto fail;
+	ret = nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_RESPONSE,
+				      ndc_id, &sched, &sched_len);
+	if (ret)
+		goto fail;
+	dl_list_del(&second.list);
+
+	/* Reject truncated attributes before reading their control byte, and
+	 * reject a time bitmap whose advertised length exceeds the attribute. */
+	first.len = ETH_ALEN;
+	if (!nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_REQUEST,
+				     ndc_id, &sched, &sched_len))
+		goto fail;
+	first.len = sizeof(candidate);
+	candidate[10] = 8;
+	if (!nan_ndl_parse_ndc_attrs(NULL, &attrs, NAN_NDL_TYPE_REQUEST,
+				     ndc_id, &sched, &sched_len))
+		goto fail;
+
+	wpa_printf(MSG_INFO, "NAN unselected NDC Request regression: PASS");
+	return 0;
+fail:
+	wpa_printf(MSG_ERROR, "NAN unselected NDC Request regression: FAIL");
+	return -1;
+}
+#endif /* CONFIG_MODULE_TESTS */
+
