[Unit]
Description=Lower the uplink MTU when the path MTU is smaller than the link
Documentation=https://www.rfc-editor.org/rfc/rfc4821
# NetworkManager owns the link and nmcli talks to it, so there is nothing to do
# before it is up. The script exits quietly when there is no default route.
After=NetworkManager.service
Wants=NetworkManager.service

[Service]
Type=oneshot
ExecStart=/usr/bin/uplink-mtu-tuning.sh
# The script logs to stdout/stderr; this is how it is tagged in the journal.
SyslogIdentifier=uplink-mtu-tuning
# Reads /sys and the socket table, writes only /run and one nmcli call.
TimeoutStartSec=30
