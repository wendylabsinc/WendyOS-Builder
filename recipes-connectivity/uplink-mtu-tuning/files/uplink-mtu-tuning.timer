[Unit]
Description=Re-check the uplink path MTU

[Timer]
# The evidence appears a few seconds after the first TCP connection of any kind:
# the kernel needs ~3s of failed retransmission (tcp_timer.c, retries1 modelled
# against TCP_RTO_MIN = 3000ms) before it clamps the socket. Detection therefore
# lands on the first tick at or after "first traffic + 3s", so the first tick is
# what sets the floor -- keep it early. Each run is one ss call against the local
# socket table and sends nothing, so a tight cadence is close to free: ~10ms of
# work, roughly 0.1% of one core at this interval.
OnBootSec=5s
OnUnitActiveSec=10s
# systemd defaults AccuracySec to 1min, which would swallow intervals this short.
AccuracySec=1s
Unit=uplink-mtu-tuning.service

[Install]
WantedBy=timers.target
