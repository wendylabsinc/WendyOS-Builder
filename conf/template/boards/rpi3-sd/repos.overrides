# Per-board repo overrides for rpi3-sd (blacksail tree).
#
# RPi3 (SD) on the blacksail OE series (fleet unification with rpi4 + rpi5 + the
# Jetsons). The legacy scarthgap board is rpi3-sd-scarthgap, kept as a fallback
# until rpi3 is confirmed on blacksail. See docs/plans/wendyos-update-rpi.md.
#
# WENDYOS_LAYER_TREE="blacksail" makes bootstrap clone every upstream repo under
# repos/blacksail/ (parallel to repos/scarthgap/). Base-stack SRCREVs mirror the
# Thor blacksail canary (jetson-agx-thor/repos.overrides), resolved 2026-08-04;
# identical to rpi4-sd / rpi5-sd.
WENDYOS_LAYER_TREE="blacksail"

# Split-poky on blacksail (oe-core master: LAYERSERIES_CORENAMES="wrynose
# blacksail", LAYERSERIES_COMPAT_core="blacksail"; meta-yocto + bitbake master).
SRCREV_BITBAKE="c870f5bd96ad02efc02c58133c27bdae3a300e3e"
SRCREV_OECORE="2faf8e366df74aded7898904b72317521a08e2f6"
SRCREV_METAYOCTO="9c6cf36c3511b94957aba04002d98bec665e9f1e"

# meta-openembedded + meta-virtualization master still declare wrynose (not
# blacksail) — bridged via blacksail-compat.inc. Re-pin + drop the bridge once
# upstream bumps.
SRCREV_OE="0a60011ec174b91104a110c353cbf18748951270"
SRCREV_VIRT="526c97254fe43e0924df034aaa825f33ec30407c"

# meta-raspberrypi: bumped to upstream master (scarthgap-era default is too old
# for blacksail oe-core). Same pin as rpi4-sd / rpi5-sd. Pinned for reproducibility.
SRCREV_RPI="9e41c54b4558709f4ff20f03dad77f2cf99477ed"

# NOTE: like rpi4 (and unlike rpi5), rpi3 (BCM2837) gets NO U-Boot override — the
# rc4 bump + NVMe patch in u-boot_%.bbappend are raspberrypi5-scoped, so rpi3
# builds STOCK blacksail U-Boot 2026.04. No meta-lts-mixins (blacksail U-Boot is
# native), no meta-lts-mixins-go (blacksail Go is 1.26 native).

