# Per-board repo overrides for rpi3-sd (blacksail tree).
#
# RPi3 (SD) on the blacksail OE series (fleet unification with rpi4 + rpi5 + the
# Jetsons). See docs/plans/wendyos-update-rpi.md.
#
# WENDYOS_LAYER_TREE="blacksail" makes bootstrap clone every upstream repo under
# repos/blacksail/. No SRCREV override: the pins come from the shared blacksail
# set in scripts/upstream-repos.env. The meta-tegra* pins in that set are
# irrelevant here — RPi never layers them.
WENDYOS_LAYER_TREE="blacksail"

# NOTE: like rpi4 (and unlike rpi5), rpi3 (BCM2837) gets NO U-Boot change — the
# NVMe patch and config fragments in u-boot_%.bbappend are raspberrypi5-scoped,
# so rpi3 builds STOCK blacksail U-Boot 2026.07. Go is native on blacksail too,
# so no backport layer is cloned.
