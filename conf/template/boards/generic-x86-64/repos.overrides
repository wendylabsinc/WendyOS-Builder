# Per-board repo version overrides for generic-x86-64.
#
# Sourced by bootstrap.sh after the default URL_*/SRCREV_* values are set,
# but before the repos[] array is built. Uncomment a line below to pin
# this board to a different commit of an upstream layer.
#
# Also available (see bootstrap.sh):
#   URL_<name>           override a source URL (e.g. to use a fork)
#   REPOS_EXTRA=(...)    append extra clones that coexist with defaults,
#                        each entry "enabled|url|folder|commit"

# Tree pin: blacksail (kernel 6.18). x86 moved off scarthgap because the target
# hardware's GPU + WiFi (Intel 8086:e340) + BT (8086:e376) are all newer than
# scarthgap's 6.6 kernel + 20240909 firmware; blacksail's 6.18 + 20260519
# firmware support them natively, and it lets the mt76 MT7920 backport be
# dropped (upstream since v6.10). No SRCREV override: this board takes the
# shared blacksail pin set from scripts/upstream-repos.env.
# See docs/plans/x86-support-plan.md.
WENDYOS_LAYER_TREE="blacksail"
