[Unit]
Description=Wendy Agent
After=network.target dbus.service containerd.service gadget-setup.service
Wants=network.target
Requires=containerd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/wendy-agent
WorkingDirectory=/var/lib/wendy-agent
ExecStart=/opt/wendyos/bin/wendy-agent
Restart=always
RestartSec=2
# A child killed for memory must not stop the agent.
OOMPolicy=continue
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
