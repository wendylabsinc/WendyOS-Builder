[Unit]
Description=Wendy Agent
# Give the active network manager's bounded wait-online service a chance to
# publish DHCP-derived DNS/search configuration before the agent reconciles
# persisted workloads. An offline device still starts the agent after that
# bounded wait completes.
After=network-online.target dbus.service containerd.service gadget-setup.service
Wants=network-online.target
# Ordering-only: when systemd-resolved is enabled, make its stable local DNS
# stub available before the agent chooses resolver wiring. Do not pull the
# optional service into images that deliberately leave it disabled.
After=systemd-resolved.service
Requires=containerd.service

[Service]
Type=simple
EnvironmentFile=-/etc/default/wendy-agent
WorkingDirectory=/var/lib/wendy-agent
ExecStart=/opt/wendyos/bin/wendy-agent
Restart=always
RestartSec=2
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
