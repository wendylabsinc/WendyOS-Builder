[Unit]
Description=Bind mount /var/lib/tee (OP-TEE secure storage) from /config
Documentation=man:systemd.mount(5)

# OP-TEE secure storage (PKCS#11 tokens, device keys, certificates, and on a
# Jetson the fTPM's own NV) is written by tee-supplicant to /var/lib/tee. That
# path is on the rootfs, which an A/B OTA replaces on every update, so it needs
# a home on a partition that survives the switch.
#
# That home is /config, NOT /data. Once the fTPM encrypts /data, /data/tee puts
# the fTPM's NV inside the very volume the fTPM has to unlock. The boot order
# says the same thing: data.mount waits for wendyos-data.service, which waits
# for /dev/tpmrm0 to unlock an encrypted /data. That needs tee-ftpm-modprobe,
# tee-supplicant and this mount, and with /data/tee this mount would need
# data.mount. The unlock would time out and /data would stay locked.
# /config is mounted early from a partition nothing encrypts, it is
# independent of /data, and it survives A/B updates just as /data does.
#
# A plaintext partition is an acceptable home because OP-TEE encrypts and
# integrity-protects the REE-FS content itself, under keys derived from the
# hardware unique key. /config gives persistence, not confidentiality -- nothing
# else put there inherits that protection.
DefaultDependencies=no
RequiresMountsFor=/config

# Must be mounted before tee-supplicant uses /var/lib/tee for secure storage.
# Assumes source-built OP-TEE (USE_PREBUILT_OPTEE=0, the meta-tegra default and
# this project's config): provider optee-client, service tee-supplicant.service,
# CFG_TEE_FS_PARENT_PATH=/var/lib/tee. The prebuilt provider (nvidia-l4t-optee,
# USE_PREBUILT_OPTEE=1) uses nv-tee-supplicant.service and an NVIDIA-controlled
# storage path -- we order before it too so the ordering is not silently lost if
# the provider is ever switched, but the /var/lib/tee path below would then need
# re-checking.
Before=tee-supplicant.service nv-tee-supplicant.service

[Mount]
What=/config/tee
Where=/var/lib/tee
Type=none
Options=bind,nosuid,nodev,x-systemd.mkdir

[Install]
WantedBy=local-fs.target
