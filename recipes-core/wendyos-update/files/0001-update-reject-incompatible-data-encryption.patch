+// Stock receivers can bootstrap plain images; LUKS2 keeps explicit v2 policy.
+func TestPackDataEncryptionFormats(t *testing.T) {
+	for _, tc := range []struct {
+		mode     string
+		format   int
+		metadata string
+	}{
+		{"plain", 1, ""}, {"luks2", 2, "luks2"},
+	} {
+		t.Run(tc.mode, func(t *testing.T) {
+			image := []byte("ordinary pack/read roundtrip")
+			path := filepath.Join(t.TempDir(), "image.ext4")
+			if err := os.WriteFile(path, image, 0600); err != nil {
+				t.Fatal(err)
+			}
+			var out bytes.Buffer
+			m, err := Pack(&out, PackOptions{ImagePath: path, ArtifactName: "ordinary", ArtifactVersion: "1", CompatibleDevices: []string{"raspberry-pi-4"}, Compression: "none", DataEncryption: tc.mode})
+			if err != nil {
+				t.Fatal(err)
+			}
+			if m.FormatVersion != tc.format || m.DataEncryption != tc.metadata {
+				t.Fatalf("packed manifest: %+v", m)
+			}
+			if tc.mode == "plain" && bytes.Contains(out.Bytes(), []byte(`"data_encryption"`)) {
+				t.Fatal("plain v1 must omit data_encryption for stock receivers")
+			}
+			r, err := Open(bytes.NewReader(out.Bytes()))
+			if err != nil {
+				t.Fatal(err)
+			}
+			if r.Manifest.FormatVersion != tc.format || r.Manifest.DataEncryption != tc.metadata {
+				t.Fatalf("read manifest: %+v", r.Manifest)
+			}
+			payload, err := r.Payload()
+			if err != nil {
+				t.Fatal(err)
+			}
+			got, err := io.ReadAll(payload)
+			if err != nil {
+				t.Fatal(err)
+			}
+			if !bytes.Equal(got, image) {
+				t.Fatal("payload changed")
+			}
+			if err := r.VerifyPayloadDigests(sha256hex(image)); err != nil {
+				t.Fatal(err)
+			}
+		})
+	}
 }
diff --git a/internal/engine/data_encryption.go b/internal/engine/data_encryption.go
new file mode 100644
index 0000000..a1ca1c9
--- /dev/null
+++ b/internal/engine/data_encryption.go
@@ -0,0 +1,89 @@
+package engine
+
+import (
+	"bytes"
+	"encoding/binary"
+	"errors"
+	"fmt"
+	"io"
+	"os"
+
+	"github.com/wendylabsinc/wendyos-update/internal/artifact"
+)
+
+const (
+	dataPartLabel = "/dev/disk/by-partlabel/data"
+	dataFSLabel   = "/dev/disk/by-label/data" // MBR Raspberry Pi has no PARTLABEL
+	ext4MagicAt   = 1024 + 56
+)
+
+var luksMagic = []byte{'L', 'U', 'K', 'S', 0xba, 0xbe}
+
+// checkDataEncryption compares the target rootfs's /data support with the
+// existing raw data partition before the inactive rootfs slot is opened.
+func (e *Engine) checkDataEncryption(m artifact.Manifest) error {
+	path := e.DataDevicePath
+	if path == "" {
+		var err error
+		path, err = findDataDevice(dataPartLabel, dataFSLabel)
+		if err != nil {
+			return reject("cannot identify live /data partition: %v", err)
+		}
+	}
+	live, err := probeDataEncryption(path)
+	if err != nil {
+		return reject("cannot identify live /data format on %s: %v", path, err)
+	}
+	if m.FormatVersion == 1 {
+		// Old artifacts carry no encryption policy. Keep upgrades working for
+		// plain-data devices, but never put an unknown old rootfs over LUKS2.
+		if live != "plain" {
+			return reject("legacy artifact has no data_encryption metadata; live /data is %s", live)
+		}
+		return nil
+	}
+	if m.DataEncryption != live {
+		return reject("artifact requires /data %s but live /data is %s", m.DataEncryption, live)
+	}
+	return nil
+}
+
+func findDataDevice(partLabel, fsLabel string) (string, error) {
+	for _, path := range []string{partLabel, fsLabel} {
+		if _, err := os.Stat(path); err == nil {
+			return path, nil
+		} else if !errors.Is(err, os.ErrNotExist) {
+			return "", err
+		}
+	}
+	return "", errors.New("neither /dev/disk/by-partlabel/data nor /dev/disk/by-label/data exists")
+}
+
+// Read on-disk signatures directly so detection works even when the target
+// image does not ship cryptsetup or blkid. Unknown/blank partitions fail closed.
+func probeDataEncryption(path string) (string, error) {
+	f, err := os.Open(path)
+	if err != nil {
+		return "", err
+	}
+	defer f.Close()
+	header := make([]byte, 8)
+	if _, err := io.ReadFull(f, header); err != nil {
+		return "", fmt.Errorf("read partition header: %w", err)
+	}
+	if bytes.Equal(header[:6], luksMagic) {
+		version := binary.BigEndian.Uint16(header[6:8])
+		if version != 2 {
+			return "", fmt.Errorf("unsupported LUKS version %d", version)
+		}
+		return "luks2", nil
+	}
+	magic := make([]byte, 2)
+	if _, err := f.ReadAt(magic, ext4MagicAt); err != nil {
+		return "", fmt.Errorf("read ext4 superblock: %w", err)
+	}
+	if magic[0] == 0x53 && magic[1] == 0xef {
+		return "plain", nil
+	}
+	return "", errors.New("partition is neither LUKS2 nor ext4")
+}
diff --git a/internal/engine/data_encryption_test.go b/internal/engine/data_encryption_test.go
new file mode 100644
index 0000000..95d0142
--- /dev/null
+++ b/internal/engine/data_encryption_test.go
@@ -0,0 +1,112 @@
+package engine
+
+import (
+	"bytes"
+	"errors"
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+
+	"github.com/wendylabsinc/wendyos-update/internal/artifact"
+	"github.com/wendylabsinc/wendyos-update/internal/connector"
+)
+
+func writeDataSignature(t *testing.T, path, mode string) {
+	t.Helper()
+	data := make([]byte, ext4MagicAt+2)
+	switch mode {
+	case "plain":
+		data[ext4MagicAt], data[ext4MagicAt+1] = 0x53, 0xef
+	case "luks2":
+		copy(data, luksMagic)
+		data[6], data[7] = 0, 2
+	case "unknown":
+	default:
+		t.Fatalf("unknown test mode %q", mode)
+	}
+	if err := os.WriteFile(path, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+}
+
+func TestInstallDataEncryptionCompatibilityBeforeWrite(t *testing.T) {
+	for _, tc := range []struct {
+		name, live, image string
+		version           int
+		accept            bool
+	}{
+		{"v2 plain on plain", "plain", "plain", 2, true},
+		{"v2 luks2 on luks2", "luks2", "luks2", 2, true},
+		{"v2 luks2 on plain", "plain", "luks2", 2, false},
+		{"v2 plain on luks2", "luks2", "plain", 2, false},
+		{"v1 on plain", "plain", "", 1, true},
+		{"v1 on luks2", "luks2", "", 1, false},
+		{"v2 missing mode", "plain", "", 2, false},
+		{"v2 unknown live format", "unknown", "plain", 2, false},
+	} {
+		t.Run(tc.name, func(t *testing.T) {
+			conn := &fakeConn{cur: connector.SlotA}
+			eng := testEngine(t, conn)
+			writeDataSignature(t, eng.DataDevicePath, tc.live)
+			art, _ := buildArtifact(t, func(m *artifact.Manifest) {
+				m.FormatVersion = tc.version
+				m.DataEncryption = tc.image
+			})
+			_, err := eng.Install(bytes.NewReader(art))
+			if tc.accept {
+				if err != nil {
+					t.Fatalf("compatible install rejected: %v", err)
+				}
+				return
+			}
+			var rejected *RejectError
+			if !errors.As(err, &rejected) {
+				t.Fatalf("want artifact rejection, got %v", err)
+			}
+			if data, err := os.ReadFile(conn.dev); err != nil || len(data) != 0 {
+				t.Fatalf("inactive slot changed before rejection: bytes=%d error=%v", len(data), err)
+			}
+			if len(conn.prepared) != 0 || len(conn.swapped) != 0 {
+				t.Fatal("connector changed before rejection")
+			}
+		})
+	}
+}
+
+func TestProbeDataEncryptionAndLabelFallback(t *testing.T) {
+	dir := t.TempDir()
+	partLabel := filepath.Join(dir, "partlabel", "data")
+	fsLabel := filepath.Join(dir, "label", "data")
+	if err := os.MkdirAll(filepath.Dir(fsLabel), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	writeDataSignature(t, fsLabel, "plain")
+	if got, err := findDataDevice(partLabel, fsLabel); err != nil || got != fsLabel {
+		t.Fatalf("MBR filesystem-label fallback = %q, %v", got, err)
+	}
+	if mode, err := probeDataEncryption(fsLabel); err != nil || mode != "plain" {
+		t.Fatalf("plain ext4 signature = %q, %v", mode, err)
+	}
+	if err := os.MkdirAll(filepath.Dir(partLabel), 0o700); err != nil {
+		t.Fatal(err)
+	}
+	writeDataSignature(t, partLabel, "luks2")
+	if got, err := findDataDevice(partLabel, fsLabel); err != nil || got != partLabel {
+		t.Fatalf("GPT partition-label preference = %q, %v", got, err)
+	}
+	if mode, err := probeDataEncryption(partLabel); err != nil || mode != "luks2" {
+		t.Fatalf("LUKS2 signature = %q, %v", mode, err)
+	}
+	data, err := os.ReadFile(partLabel)
+	if err != nil {
+		t.Fatal(err)
+	}
+	data[6], data[7] = 0, 1
+	if err := os.WriteFile(partLabel, data, 0o600); err != nil {
+		t.Fatal(err)
+	}
+	if _, err := probeDataEncryption(partLabel); err == nil || !strings.Contains(err.Error(), "unsupported LUKS version") {
+		t.Fatalf("LUKS1 must be refused: %v", err)
+	}
+}
