[Unit]
Description=WendyOS persistent data partition (/data)
# The unit that prepares /data before the mount is wendyos-data.service
# (data-device). Nothing is declared here: that unit pulls itself in through its
# own [Install] WantedBy=data.mount and orders itself with Before=data.mount, so
# this mount stays identical to the one systemd-fstab-generator writes on the
# boards that do have a /data fstab entry.

[Mount]
What=/dev/wendyos/data
Where=/data
Type=ext4
Options=defaults,noatime

[Install]
WantedBy=local-fs.target
