 }
 
+/* list_lock must be held. Allocated buffers remain in outbufs_list for
+ * capture history; only completed writes belong to the OUTPUT done queue. */
+static struct v4l2l_buffer *next_output_buffer(struct v4l2_loopback_device *dev)
+{
+	struct v4l2l_buffer *buf;
+
+	list_for_each_entry(buf, &dev->outbufs_list, list_head)
+		if (buf->output_pending)
+			return buf;
+	return NULL;
+}
+
+static bool output_buffer_pending(struct v4l2_loopback_device *dev)
+{
+	bool pending;
+
+	spin_lock_bh(&dev->list_lock);
+	pending = next_output_buffer(dev) != NULL;
+	spin_unlock_bh(&dev->list_lock);
+	return pending;
+}
+
 /* put buffer to dequeue
  * called on VIDIOC_DQBUF
  */
@@ -2028,18 +2063,26 @@
 		unset_flags(buf->flags);
 		break;
 	case V4L2_BUF_TYPE_VIDEO_OUTPUT:
-		spin_lock_bh(&dev->list_lock);
-
-		bufd = list_first_entry_or_null(&dev->outbufs_list,
-						struct v4l2l_buffer, list_head);
-		if (bufd)
-			list_move_tail(&bufd->list_head, &dev->outbufs_list);
-
-		spin_unlock_bh(&dev->list_lock);
-		if (!bufd)
-			return -EFAULT;
-		unset_flags(bufd->buffer.flags);
-		*buf = bufd->buffer;
+		for (;;) {
+			spin_lock_bh(&dev->list_lock);
+			bufd = next_output_buffer(dev);
+			if (bufd) {
+				bufd->output_pending = false;
+				unset_flags(bufd->buffer.flags);
+				*buf = bufd->buffer;
+			}
+			spin_unlock_bh(&dev->list_lock);
+			if (bufd)
+				break;
+			if ((file->f_flags & O_NONBLOCK) ||
+			    !has_output_token(READ_ONCE(opener->stream_token)))
+				return -EAGAIN;
+			if (wait_event_interruptible(
+				    dev->read_event,
+				    !has_output_token(READ_ONCE(opener->stream_token)) ||
+					    output_buffer_pending(dev)))
+				return -ERESTARTSYS;
+		}
 		break;
 	default:
 		return -EINVAL;
@@ -2116,7 +2159,9 @@
 			release_token(dev, opener, stream);
 		/* reset output queue */
 		if (dev->used_buffer_count > 0)
-			prepare_buffer_queue(dev, dev->used_buffer_count);
+			prepare_buffer_queue(dev, dev->used_buffer_count, true);
+		/* A blocking OUTPUT DQBUF must observe stream cancellation. */
+		wake_up_all(&dev->read_event);
 		return 0;
 	case V4L2_BUF_TYPE_VIDEO_CAPTURE:
 		if (opener->stream_token & token) {
@@ -2323,8 +2368,10 @@
 
 	switch (opener->format_token) {
 	case V4L2L_TOKEN_OUTPUT:
-		if (opener->stream_token != 0 ||
-		    opener->io_method == V4L2L_IO_NONE)
+		if (opener->io_method == V4L2L_IO_NONE ||
+		    (opener->stream_token != 0 &&
+		     (opener->io_method != V4L2L_IO_MMAP ||
+		      output_buffer_pending(dev))))
 			ret_mask |= POLLOUT | POLLWRNORM;
 		break;
 	case V4L2L_TOKEN_CAPTURE:
@@ -2535,7 +2582,6 @@
 	b->sequence = dev->write_position;
