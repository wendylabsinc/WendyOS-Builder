 	}
 exit_reqbufs_unlock:
@@ -1837,6 +1844,13 @@
 		++dev->write_position;
 		dev->reread_count = 0;
 		spin_unlock_bh(&dev->lock);
+
+		/* Publish only after the frame metadata and capture position are final.
+		 * A concurrent DQBUF may return ownership immediately at this point. */
+		spin_lock_bh(&dev->list_lock);
+		set_done(buf->buffer.flags);
+		buf->output_pending = true;
+		spin_unlock_bh(&dev->list_lock);
 	}
 	mutex_unlock(&dev->image_mutex);
 
@@ -1916,7 +1930,6 @@
 		set_queued(bufd->buffer.flags);
 		*buf = bufd->buffer;
 		buffer_written(dev, bufd);
-		set_done(bufd->buffer.flags);
 		wake_up_all(&dev->read_event);
 		break;
 	default:
@@ -1996,6 +2009,28 @@
