+				 bool reset_output)
 {
 	struct v4l2l_buffer *bufd, *n;
 	u32 pos;
@@ -1618,6 +1622,8 @@
 	/* ensure sufficient number of buffers in queue */
 	for (pos = 0; pos < count; ++pos) {
 		bufd = &dev->buffers[pos];
+		if (reset_output)
+			bufd->output_pending = false;
 		if (list_empty(&bufd->list_head))
