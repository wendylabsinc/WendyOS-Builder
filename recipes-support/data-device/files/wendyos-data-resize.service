[Unit]
Description=WendyOS grow the /data filesystem online to fill its partition
# The second half of the /data grow: the slow resize2fs, run ONLINE on the
# mounted /data so discovery, the agent and every other /data consumer come up
# at data.mount instead of minutes later. wendyos-data.service already grew the
# PARTITION before the mount; this fills it. Idempotent: resize2fs no-ops once
# the filesystem is full.
#
# Was grow-data-fs-online.service. Renamed with the recipe it was named after:
# the grow now belongs to wendyos-data.service, and this is the half of it that
# runs after the mount.
DefaultDependencies=no
Requires=data.mount
After=data.mount
BindsTo=data.mount
Conflicts=shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# Generous (a multi-GiB resize on a slow card takes minutes) but off the boot
# path, yet finite so a wedged resize2fs fails and retries next boot rather
# than hangs.
TimeoutStartSec=1800
ExecStart=/usr/sbin/wendyos-data.sh resize

[Install]
WantedBy=multi-user.target
