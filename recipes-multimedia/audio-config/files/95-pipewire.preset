# Systemd system preset for the PipeWire multimedia stack.
#
# PipeWire runs system-wide as the "pipewire" user, but ships with its session
# manager disabled. Without WirePlumber the graph stays empty: no ALSA, no
# Bluetooth and no camera nodes are ever published.

enable pipewire.socket
enable pipewire.service
enable wireplumber.service
enable pipewire-pulse.socket
enable pipewire-pulse.service
