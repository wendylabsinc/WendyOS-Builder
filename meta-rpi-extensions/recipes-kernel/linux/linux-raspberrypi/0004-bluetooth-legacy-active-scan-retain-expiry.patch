+struct hci_legacy_scan_adv {
+	bool paused;
+	bool management;
+	bool refresh;
+	u8 instance;
+};
+
+/* Called with hdev->lock held. A running timer callback may already have
+ * cleared its pending bit, or queued expiry behind this scan and cleared
+ * adv_instance_timeout. The original sync expiry still owns that slice.
+ * A canceled/unarmed timer alone does not expire an unlimited instance.
+ */
+static bool hci_legacy_scan_adv_expired(struct hci_dev *hdev, u8 instance)
+{
+	struct hci_cmd_sync_work_entry *entry;
+	bool expired = false;
+
+	if (hdev->expired_adv_instance == instance)
+		return true;
+
+	/* delay==0 queues work without rewriting timer.expires. The owned
+	 * slice deadline also survives a later allocation-retry timer date.
+	 */
+	if (hdev->adv_instance_expire_armed &&
+	    time_after_eq(jiffies, hdev->adv_instance_expire_deadline))
+		return true;
+
+	mutex_lock(&hdev->cmd_sync_work_lock);
+	list_for_each_entry(entry, &hdev->cmd_sync_work_list, list) {
+		if (entry->func == adv_timeout_expire_sync && entry->data &&
+		    *(u8 *)entry->data == instance) {
+			expired = true;
+			break;
+		}
+	}
+	mutex_unlock(&hdev->cmd_sync_work_lock);
+
+	return expired;
+}
+
+/* A scan address update must not reschedule advertising or spend another
+ * rotation slice. Keep the original instance/deadlines and pause only the
+ * legacy advertiser whose command family shares the scan random address.
+ */
+static int hci_legacy_scan_adv_pause_sync(struct hci_dev *hdev,
+					struct hci_legacy_scan_adv *state)
+{
+	int err = 0;
+
+	hci_dev_lock(hdev);
+	if (hci_lookup_le_connect(hdev)) {
+		err = -EBUSY;
+		goto unlock;
+	}
+
+	/* An outside pause may coexist with directed connection advertising.
+	 * Never release it or change that advertiser's address.
+	 */
+	if (hdev->advertising_paused) {
+		if (hci_dev_test_flag(hdev, HCI_LE_ADV))
+			err = -EBUSY;
+		goto unlock;
+	}
+
+	if (!hci_dev_test_flag(hdev, HCI_LE_ADV))
+		goto unlock;
+
+	state->management = hci_dev_test_flag(hdev, HCI_ADVERTISING);
+	state->instance = hdev->cur_adv_instance;
+	if (!state->instance && !state->management) {
+		err = -EBUSY;
+		goto unlock;
+	}
+
+	/* Set Advertising/Discoverable inspect this pause. Other management
+	 * callers may still update intent while HCI commands wait, so resume
+	 * and the final enable boundary revalidate the current state.
+	 */
+	hdev->advertising_paused = true;
+	state->paused = true;
+	hci_dev_unlock(hdev);
+
+	return hci_disable_advertising_sync(hdev);
+
+unlock:
+	hci_dev_unlock(hdev);
+	return err;
+}
+
+/* Revalidate at the final enable boundary, after all HCI parameter waits.
+ * A newly expired discovery setting needs fresh AD/address parameters; an
+ * expired instance is left disabled for its original queued rotation work.
+ */
+static bool hci_legacy_scan_adv_can_enable(struct hci_dev *hdev, void *data)
+{
+	struct hci_legacy_scan_adv *state = data;
+	bool allowed;
+
+	hci_dev_lock(hdev);
+	if (hdev->discov_timeout && delayed_work_pending(&hdev->discov_off) &&
+	    time_after_eq(jiffies, hdev->discov_off.timer.expires)) {
+		hci_dev_clear_flag(hdev, HCI_LIMITED_DISCOVERABLE);
+		hci_dev_clear_flag(hdev, HCI_DISCOVERABLE);
+		hdev->discov_timeout = 0;
+		state->refresh = true;
+	}
+
+	allowed = !hci_lookup_le_connect(hdev) &&
+		  hdev->cur_adv_instance == state->instance;
+	if (state->management)
+		allowed = allowed && hci_dev_test_flag(hdev, HCI_ADVERTISING);
+	else
+		allowed = allowed && !hci_dev_test_flag(hdev, HCI_ADVERTISING) &&
+			  hci_find_adv_instance(hdev, state->instance) &&
+			  !hci_legacy_scan_adv_expired(hdev, state->instance);
+	hci_dev_unlock(hdev);
+
+	if (!allowed)
+		state->refresh = false;
+	return allowed && !state->refresh;
+}
+
+static int hci_legacy_scan_adv_resume_sync(struct hci_dev *hdev,
+					 struct hci_legacy_scan_adv *state)
+{
+	bool resume = false;
+	int err = 0;
+
+	if (!state->paused)
+		return 0;
+	state->paused = false;
+
+	hci_dev_lock(hdev);
+	/* Preserve actual expiry rather than restoring saved discoverability.
+	 * Its original queued work still publishes the settings change.
+	 */
+	if (hdev->discov_timeout && delayed_work_pending(&hdev->discov_off) &&
+	    time_after_eq(jiffies, hdev->discov_off.timer.expires)) {
+		hci_dev_clear_flag(hdev, HCI_LIMITED_DISCOVERABLE);
+		hci_dev_clear_flag(hdev, HCI_DISCOVERABLE);
+		hdev->discov_timeout = 0;
+	}
+
+	if (!hci_dev_test_flag(hdev, HCI_LE_ADV) &&
+	    !hci_lookup_le_connect(hdev)) {
+		if (state->management) {
+			resume = hci_dev_test_flag(hdev, HCI_ADVERTISING) &&
+				 hdev->cur_adv_instance == 0x00;
+		} else if (!hci_dev_test_flag(hdev, HCI_ADVERTISING) &&
+			   hdev->cur_adv_instance == state->instance &&
+			   hci_find_adv_instance(hdev, state->instance)) {
+			/* The original queued expiry owns rotation/removal. Do not
+			 * restart a slice whose wall-clock deadline already passed.
+			 */
+			resume = !hci_legacy_scan_adv_expired(hdev, state->instance);
+		}
+	}
+	hci_dev_unlock(hdev);
+
+	if (resume) {
+		do {
+			state->refresh = false;
+			err = hci_update_adv_data_sync(hdev, state->instance);
+			if (err)
+				break;
+			err = hci_update_scan_rsp_data_sync(hdev, state->instance);
+			if (err)
+				break;
+			err = __hci_enable_advertising_sync(hdev,
+					 hci_legacy_scan_adv_can_enable, state);
+		} while (!err && state->refresh);
+	}
+
+	hci_dev_lock(hdev);
+	hdev->advertising_paused = false;
+	/* Restore may have written a different random address before a later
+	 * HCI parameter/enable failure. Expire that stale RPA on error too.
+	 */
+	if (bacmp(&hdev->random_addr, &hdev->rpa))
+		hci_dev_set_flag(hdev, HCI_RPA_EXPIRED);
+	hci_dev_unlock(hdev);
+
+	return err;
+}
+
+/* Legacy scanning and advertising share one random address. Restoring an
+ * advertiser can select NRPA/static instead of the scan's RPA, or static
+ * instead of its NRPA. Preserve the existing public-address scan fallback
+ * in that case; do not enable scanning with a stale private address type.
+ */
+static u8 hci_legacy_scan_own_addr_type(struct hci_dev *hdev, u8 own_addr_type)
+{
+	hci_dev_lock(hdev);
+	/* A successful non-RPA write does not expire the global RPA cache in
+	 * its completion callback. Validate the actual final shared address.
+	 */
+	if (bacmp(&hdev->random_addr, &hdev->rpa))
+		hci_dev_set_flag(hdev, HCI_RPA_EXPIRED);
+
+	if (own_addr_type != ADDR_LE_DEV_PUBLIC) {
+		if (scan_use_rpa(hdev)) {
+			if (!rpa_valid(hdev))
+				own_addr_type = ADDR_LE_DEV_PUBLIC;
+		} else if (hdev->random_addr.b[5] & 0xc0) {
+			own_addr_type = ADDR_LE_DEV_PUBLIC;
+		}
+	}
+	hci_dev_unlock(hdev);
+
+	return own_addr_type;
+}
