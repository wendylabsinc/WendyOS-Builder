[Unit]
Description=Restore the wendy account entry kept on /data
DefaultDependencies=no
Conflicts=shutdown.target
After=local-fs.target data.mount
Requires=data.mount
# Before any login path: sshd is socket-activated right after sysinit.
Before=sysinit.target shutdown.target

[Service]
Type=oneshot
RemainAfterExit=yes
# A oneshot has no start timeout by default, and this one is in the boot path.
TimeoutStartSec=60
TimeoutStopSec=60
ExecStart=/usr/sbin/wendyos-user-credential.sh restore
# Catch a change the watcher missed and a store lost with /data.
ExecStartPost=-/usr/sbin/wendyos-user-credential.sh save
ExecStop=-/usr/sbin/wendyos-user-credential.sh save

[Install]
WantedBy=sysinit.target
