[Unit]
Description=Keep the wendy account entry on /data
RequiresMountsFor=/data
After=data.mount wendyos-user-credential-restore.service
# A burst of account changes must not stop the watcher.
StartLimitIntervalSec=0

[Service]
Type=oneshot
TimeoutStartSec=60
ExecStart=/usr/sbin/wendyos-user-credential.sh save
