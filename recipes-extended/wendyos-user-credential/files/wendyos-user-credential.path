[Unit]
Description=Watch /etc/shadow for a changed wendy account entry
# Never save before the restore: a new slot's locked entry would replace the
# saved one.
Requires=wendyos-user-credential-restore.service
After=wendyos-user-credential-restore.service

[Path]
PathChanged=/etc/shadow
Unit=wendyos-user-credential-save.service

[Install]
WantedBy=paths.target
