[Unit]
Description=Keep the wendy account entry on /data current
RequiresMountsFor=/data
# Never save before the restore: a new slot's locked entry would replace the
# saved one.
Requires=wendyos-user-credential-restore.service
After=wendyos-user-credential-restore.service

[Service]
ExecStart=/usr/sbin/wendyos-user-credential.sh watch
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
