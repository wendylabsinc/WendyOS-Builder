# Enforce password quality before pam_unix commits a new local credential.
# Negative credits require each character class and do not reduce minlen.
# enforce_for_root also covers administrative provisioning with passwd.
password requisite pam_pwquality.so retry=3 minlen=15 dcredit=-1 ucredit=-1 lcredit=-1 ocredit=-1 enforce_for_root
password [success=1 default=ignore] pam_unix.so sha512 use_authtok
password requisite pam_deny.so
password required pam_permit.so
